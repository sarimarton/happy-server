DATABASE_URL=postgresql://postgres:postgres@localhost:5432/handy
REDIS_URL=redis://localhost:6379
HANDY_MASTER_SECRET=change-me-in-production

PORT=25718

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Logging (creates .logs directory)
# DANGEROUSLY_LOG_TO_SERVER_FOR_AI_AUTO_DEBUGGING=true

# S3/MinIO
S3_HOST=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=happy
S3_PUBLIC_URL=http://localhost:9000/happy

NODE_ENV=development

# Tailscale (for startup banner, optional)
# TAILSCALE_HOSTNAME=your-machine.tailnet.ts.net

# Fancy Terminal UI (set to false for plain output)
# HAPPY_FANCY_UI=true
